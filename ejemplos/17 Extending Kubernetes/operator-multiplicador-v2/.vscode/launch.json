{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Kubernetes Operator",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 40000,
            "host": "127.0.0.1",
            "showLog": true,
            "trace": "verbose",
            "stopOnEntry": true,
            "substitutePath": [
            {
            "from": "${workspaceFolder}",
            "to": "/src"                    
            }
            ]
        }
    ]
}